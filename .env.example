# Copia a .env y reemplaza los CHANGE_ME (nunca subas .env al repo).
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=false
JWT_SIGNING_KEY=CHANGE_ME_MIN_32_CARACTERES_ALEATORIOS
POSTGRES_PASSWORD=CHANGE_ME
# Contraseña de los usuarios demo (docker compose exec auth python manage.py seed_demo)
DEMO_PASSWORD=CHANGE_ME_DemoPass_2026
# IA: mock (sin red) o gemini
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
